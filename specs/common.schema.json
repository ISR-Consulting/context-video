{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-video/specs/common.schema.json",
  "title": "Context Video Common Definitions",
  "$defs": {
    "contentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contentId",
        "contentType"
      ],
      "properties": {
        "contentId": {
          "type": "string",
          "minLength": 1
        },
        "contentType": {
          "type": "string",
          "enum": [
            "LIVE",
            "VOD"
          ]
        }
      }
    },
    "timeWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startMs",
        "endMs"
      ],
      "properties": {
        "startMs": {
          "type": "integer",
          "minimum": 0
        },
        "endMs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "observationProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "pipelineVersion"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string"
        },
        "pipelineVersion": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "semanticValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "confidence"
      ],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
