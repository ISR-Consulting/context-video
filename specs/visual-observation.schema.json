{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-video/specs/visual-observation.schema.json",
  "title": "VisualObservation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observationId",
    "content",
    "window",
    "frames",
    "provenance"
  ],
  "properties": {
    "observationId": {
      "type": "string",
      "minLength": 1
    },
    "content": {
      "$ref": "common.schema.json#/$defs/contentRef"
    },
    "window": {
      "$ref": "common.schema.json#/$defs/timeWindow"
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "timestampMs",
          "observations"
        ],
        "properties": {
          "timestampMs": {
            "type": "integer",
            "minimum": 0
          },
          "description": {
            "type": "string"
          },
          "observations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "value",
                "confidence"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "OBJECT",
                    "ENTITY",
                    "TOPIC",
                    "BRAND",
                    "TEXT",
                    "SCENE",
                    "ACTION"
                  ]
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        }
      }
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/observationProvenance"
    }
  }
}
